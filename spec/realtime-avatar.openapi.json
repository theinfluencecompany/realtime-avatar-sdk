{
  "openapi": "3.1.0",
  "info": {
    "title": "Realtime Avatar LiveKit API",
    "version": "1.0.0",
    "description": "LiveKit-first realtime avatar session, capacity, and AgentWorker lifecycle API."
  },
  "components": {
    "securitySchemes": {
      "bearerAuth": {
        "type": "http",
        "scheme": "bearer"
      }
    },
    "schemas": {
      "LiveKitSessionRequest": {
        "$schema": "https://json-schema.org/draft/2020-12/schema",
        "type": "object",
        "properties": {
          "avatar_id": {
            "default": "maria",
            "type": "string",
            "minLength": 1,
            "maxLength": 160
          },
          "background_id": {
            "default": "plain_white",
            "type": "string",
            "minLength": 1,
            "maxLength": 160
          },
          "capacity_pool": {
            "default": "primary",
            "type": "string",
            "minLength": 1,
            "maxLength": 80
          },
          "mode": {
            "default": "avatar",
            "type": "string",
            "enum": [
              "avatar",
              "voice"
            ]
          },
          "create_room": {
            "default": true,
            "type": "boolean"
          },
          "dispatch_agent": {
            "default": true,
            "type": "boolean"
          },
          "instructions": {
            "type": "string",
            "minLength": 1,
            "maxLength": 4000
          },
          "initial_context": {
            "default": [],
            "maxItems": 32,
            "type": "array",
            "items": {
              "type": "object",
              "properties": {
                "role": {
                  "type": "string",
                  "enum": [
                    "system",
                    "user",
                    "assistant"
                  ]
                },
                "content": {
                  "type": "string",
                  "minLength": 1,
                  "maxLength": 4000
                }
              },
              "required": [
                "role",
                "content"
              ],
              "additionalProperties": false
            }
          },
          "initial_say": {
            "type": "string",
            "minLength": 1,
            "maxLength": 1000
          },
          "llm": {
            "anyOf": [
              {
                "type": "object",
                "properties": {
                  "backend": {
                    "type": "string",
                    "enum": [
                      "local",
                      "gemini",
                      "openai"
                    ]
                  },
                  "model": {
                    "anyOf": [
                      {
                        "type": "string",
                        "maxLength": 200
                      },
                      {
                        "type": "null"
                      }
                    ]
                  }
                },
                "additionalProperties": false
              },
              {
                "type": "null"
              }
            ]
          },
          "max_session_seconds": {
            "type": "integer",
            "minimum": 1,
            "maximum": 1800
          },
          "participant_identity": {
            "type": "string",
            "minLength": 1,
            "maxLength": 160
          },
          "participant_name": {
            "type": "string",
            "maxLength": 160
          },
          "character_name": {
            "type": "string",
            "minLength": 1,
            "maxLength": 160
          },
          "queue_ticket_id": {
            "type": "string",
            "minLength": 1,
            "maxLength": 160
          },
          "room_name": {
            "type": "string",
            "minLength": 1,
            "maxLength": 160
          },
          "source_kind": {
            "default": "source_video",
            "description": "The realtime source. Creation is image-only — every avatar grows its own PLATFORM-GENERATED looping source video from the uploaded portrait — so this is always \"source_video\".",
            "type": "string",
            "enum": [
              "source_video"
            ]
          },
          "source_video_url": {
            "description": "Normally omitted: the avatar's platform-generated idle loop is resolved server-side. Overriding it with a custom video URL is a legacy channel for existing integrations — custom video is not part of the public contract.",
            "anyOf": [
              {
                "type": "string",
                "format": "uri"
              },
              {
                "type": "null"
              }
            ]
          },
          "stt_mode": {
            "default": "server",
            "type": "string",
            "enum": [
              "server",
              "off"
            ]
          },
          "video_cache_id": {
            "anyOf": [
              {
                "type": "string",
                "minLength": 1,
                "maxLength": 240
              },
              {
                "type": "null"
              }
            ]
          },
          "voice": {
            "anyOf": [
              {
                "oneOf": [
                  {
                    "type": "object",
                    "properties": {
                      "provider": {
                        "type": "string",
                        "const": "cartesia"
                      },
                      "model": {
                        "default": "cartesia/sonic-3",
                        "type": "string",
                        "enum": [
                          "cartesia/sonic-2",
                          "cartesia/sonic-2-latest",
                          "cartesia/sonic-3",
                          "cartesia/sonic-3-latest",
                          "cartesia/sonic-turbo",
                          "cartesia/sonic-turbo-latest"
                        ]
                      },
                      "voice_id": {
                        "type": "string",
                        "minLength": 1,
                        "maxLength": 120
                      },
                      "speed": {
                        "anyOf": [
                          {
                            "type": "number",
                            "minimum": 0.5,
                            "maximum": 2
                          },
                          {
                            "type": "null"
                          }
                        ]
                      },
                      "emotion": {
                        "anyOf": [
                          {
                            "type": "string",
                            "minLength": 1,
                            "maxLength": 80
                          },
                          {
                            "type": "null"
                          }
                        ]
                      },
                      "language": {
                        "anyOf": [
                          {
                            "type": "string",
                            "minLength": 2,
                            "maxLength": 16
                          },
                          {
                            "type": "null"
                          }
                        ]
                      }
                    },
                    "required": [
                      "provider",
                      "voice_id"
                    ],
                    "additionalProperties": false
                  },
                  {
                    "type": "object",
                    "properties": {
                      "provider": {
                        "type": "string",
                        "const": "breezeblue"
                      },
                      "model": {
                        "default": "bluebell-v1-en",
                        "type": "string",
                        "minLength": 1,
                        "maxLength": 80
                      },
                      "voice_id": {
                        "type": "string",
                        "minLength": 1,
                        "maxLength": 120
                      },
                      "guidance_scale": {
                        "anyOf": [
                          {
                            "type": "number",
                            "minimum": 1,
                            "maximum": 10
                          },
                          {
                            "type": "null"
                          }
                        ]
                      },
                      "instructions": {
                        "anyOf": [
                          {
                            "type": "string",
                            "minLength": 1,
                            "maxLength": 1000
                          },
                          {
                            "type": "null"
                          }
                        ]
                      },
                      "language": {
                        "anyOf": [
                          {
                            "type": "string",
                            "minLength": 2,
                            "maxLength": 16
                          },
                          {
                            "type": "null"
                          }
                        ]
                      }
                    },
                    "required": [
                      "provider",
                      "voice_id"
                    ],
                    "additionalProperties": false
                  },
                  {
                    "type": "object",
                    "properties": {
                      "provider": {
                        "type": "string",
                        "const": "fish"
                      },
                      "model": {
                        "default": "speech-1.6",
                        "type": "string",
                        "enum": [
                          "speech-1.6",
                          "s1",
                          "s2-pro",
                          "speech-1.5",
                          "s1-mini"
                        ]
                      },
                      "voice_id": {
                        "type": "string",
                        "minLength": 1,
                        "maxLength": 120
                      },
                      "speed": {
                        "anyOf": [
                          {
                            "type": "number",
                            "minimum": 0.5,
                            "maximum": 2
                          },
                          {
                            "type": "null"
                          }
                        ]
                      },
                      "emotion": {
                        "anyOf": [
                          {
                            "type": "string",
                            "minLength": 1,
                            "maxLength": 80
                          },
                          {
                            "type": "null"
                          }
                        ]
                      },
                      "language": {
                        "anyOf": [
                          {
                            "type": "string",
                            "minLength": 2,
                            "maxLength": 16
                          },
                          {
                            "type": "null"
                          }
                        ]
                      }
                    },
                    "required": [
                      "provider",
                      "voice_id"
                    ],
                    "additionalProperties": false
                  }
                ]
              },
              {
                "type": "null"
              }
            ]
          },
          "voice_id": {
            "anyOf": [
              {
                "type": "string",
                "minLength": 1,
                "maxLength": 240
              },
              {
                "type": "null"
              }
            ]
          },
          "clip_library": {
            "description": "The session's motion-state map. Normally omitted: the avatar's PLATFORM-GENERATED library (idle / listen / gesture clips rendered from the portrait at creation) is injected automatically. An explicit [] opts the call out of clips. Supplying custom clip URLs is a legacy channel for existing integrations — custom video is not part of the public contract.",
            "type": "array",
            "items": {
              "type": "object",
              "properties": {
                "clip_id": {
                  "type": "string",
                  "pattern": "^[A-Za-z0-9_-]{1,64}$"
                },
                "source_video_url": {
                  "description": "The clip's video URL — for a platform-generated library this is the generated clip's hosted URL, filled in server-side at hydration.",
                  "type": "string",
                  "format": "uri"
                },
                "video_cache_id": {
                  "type": "string",
                  "minLength": 8,
                  "maxLength": 160
                },
                "max_seconds": {
                  "type": "number",
                  "minimum": 1,
                  "maximum": 10
                },
                "trigger": {
                  "type": "string",
                  "enum": [
                    "idle",
                    "listen",
                    "think",
                    "directive"
                  ]
                },
                "loop": {
                  "type": "boolean"
                },
                "weight": {
                  "type": "number",
                  "minimum": 0,
                  "maximum": 100
                },
                "crossfade_ms": {
                  "type": "integer",
                  "minimum": 0,
                  "maximum": 1000
                },
                "trim_start_ms": {
                  "type": "integer",
                  "minimum": 0,
                  "maximum": 2000
                },
                "trim_end_ms": {
                  "type": "integer",
                  "minimum": 0,
                  "maximum": 2000
                },
                "when": {
                  "type": "string",
                  "minLength": 1,
                  "maxLength": 120
                },
                "hint": {
                  "type": "string",
                  "minLength": 1,
                  "maxLength": 120
                }
              },
              "required": [
                "clip_id"
              ],
              "additionalProperties": false
            }
          },
          "choreography": {
            "type": "object",
            "properties": {
              "idle_dwell_min_seconds": {
                "type": "number",
                "minimum": 1,
                "maximum": 60
              },
              "idle_dwell_max_seconds": {
                "type": "number",
                "minimum": 1,
                "maximum": 120
              },
              "special_weight": {
                "type": "number",
                "minimum": 0,
                "maximum": 100
              },
              "start_grace_seconds": {
                "type": "number",
                "minimum": 0,
                "maximum": 60
              },
              "crossfade_ms": {
                "type": "integer",
                "minimum": 0,
                "maximum": 1000
              },
              "crossfade_easing": {
                "type": "string",
                "enum": [
                  "linear",
                  "smooth",
                  "ease_out"
                ]
              },
              "wrap_crossfade_ms": {
                "type": "integer",
                "minimum": 0,
                "maximum": 1000
              }
            },
            "additionalProperties": false
          },
          "scene_graph": {
            "type": "object",
            "properties": {
              "scenes": {
                "minItems": 1,
                "maxItems": 4,
                "type": "array",
                "items": {
                  "type": "object",
                  "properties": {
                    "scene_id": {
                      "type": "string",
                      "pattern": "^[a-z0-9_]{1,40}$"
                    },
                    "hub_clip_id": {
                      "type": "string",
                      "pattern": "^[A-Za-z0-9_-]{1,64}$"
                    },
                    "clips": {
                      "minItems": 1,
                      "maxItems": 4,
                      "type": "array",
                      "items": {
                        "type": "object",
                        "properties": {
                          "clip_id": {
                            "type": "string",
                            "pattern": "^[A-Za-z0-9_-]{1,64}$"
                          },
                          "source_video_url": {
                            "description": "The clip's video URL — for a platform-generated library this is the generated clip's hosted URL, filled in server-side at hydration.",
                            "type": "string",
                            "format": "uri"
                          },
                          "video_cache_id": {
                            "type": "string",
                            "minLength": 8,
                            "maxLength": 160
                          },
                          "max_seconds": {
                            "type": "number",
                            "minimum": 1,
                            "maximum": 10
                          },
                          "trigger": {
                            "type": "string",
                            "enum": [
                              "idle",
                              "listen",
                              "think",
                              "directive"
                            ]
                          },
                          "loop": {
                            "type": "boolean"
                          },
                          "weight": {
                            "type": "number",
                            "minimum": 0,
                            "maximum": 100
                          },
                          "crossfade_ms": {
                            "type": "integer",
                            "minimum": 0,
                            "maximum": 1000
                          },
                          "trim_start_ms": {
                            "type": "integer",
                            "minimum": 0,
                            "maximum": 2000
                          },
                          "trim_end_ms": {
                            "type": "integer",
                            "minimum": 0,
                            "maximum": 2000
                          },
                          "when": {
                            "type": "string",
                            "minLength": 1,
                            "maxLength": 120
                          },
                          "hint": {
                            "type": "string",
                            "minLength": 1,
                            "maxLength": 120
                          }
                        },
                        "required": [
                          "clip_id"
                        ],
                        "additionalProperties": false
                      }
                    }
                  },
                  "required": [
                    "scene_id",
                    "hub_clip_id",
                    "clips"
                  ],
                  "additionalProperties": false
                }
              },
              "transitions": {
                "minItems": 2,
                "maxItems": 12,
                "type": "array",
                "items": {
                  "type": "object",
                  "properties": {
                    "clip_id": {
                      "type": "string",
                      "pattern": "^[A-Za-z0-9_-]{1,64}$"
                    },
                    "source_video_url": {
                      "type": "string",
                      "format": "uri"
                    },
                    "from_scene": {
                      "type": "string",
                      "pattern": "^[a-z0-9_]{1,40}$"
                    },
                    "to_scene": {
                      "type": "string",
                      "pattern": "^[a-z0-9_]{1,40}$"
                    },
                    "max_seconds": {
                      "type": "number",
                      "minimum": 1,
                      "maximum": 10
                    }
                  },
                  "required": [
                    "clip_id",
                    "source_video_url",
                    "from_scene",
                    "to_scene"
                  ],
                  "additionalProperties": false
                }
              }
            },
            "required": [
              "scenes",
              "transitions"
            ],
            "additionalProperties": false
          },
          "behavior": {
            "type": "object",
            "properties": {
              "gestures_enabled": {
                "type": "boolean"
              },
              "gesture_freq": {
                "type": "string",
                "enum": [
                  "sparse",
                  "balanced",
                  "lively"
                ]
              }
            },
            "additionalProperties": false
          },
          "expression_profile": {
            "type": "string",
            "minLength": 1,
            "maxLength": 40
          },
          "render_backend": {
            "type": "string",
            "enum": [
              "warp",
              "generative"
            ]
          },
          "support_edits": {
            "type": "object",
            "properties": {
              "instruction": {
                "type": "string",
                "minLength": 1,
                "maxLength": 1000
              },
              "reference_url": {
                "type": "string",
                "format": "uri"
              },
              "live_edit": {
                "description": "EXPERIMENTAL (\"runtime edit\") — let the look follow the conversation mid-call. Less settled than the fixed `instruction` lane: the shape may still change, and the re-dress does not reach every capacity tier yet, so a live session is accepted and runs normally but may hold its opening set for the whole call. Absent means `instruction` is fixed for the session, which is the incumbent behavior.",
                "type": "object",
                "properties": {
                  "rules": {
                    "type": "string",
                    "minLength": 1,
                    "maxLength": 2000
                  },
                  "cooldown_seconds": {
                    "type": "integer",
                    "minimum": 5,
                    "maximum": 600
                  },
                  "renderer": {
                    "type": "string",
                    "enum": [
                      "editor",
                      "generative"
                    ]
                  }
                },
                "required": [
                  "rules"
                ],
                "additionalProperties": false
              }
            },
            "required": [
              "instruction"
            ],
            "additionalProperties": false
          },
          "capabilities": {
            "maxItems": 4,
            "type": "array",
            "items": {
              "type": "string",
              "enum": [
                "emotion_director",
                "client_tools",
                "video_edit_control"
              ]
            }
          },
          "transcript_webhook": {
            "type": "object",
            "properties": {
              "url": {
                "type": "string",
                "maxLength": 500,
                "format": "uri"
              },
              "secret": {
                "type": "string",
                "minLength": 16,
                "maxLength": 200
              }
            },
            "required": [
              "url",
              "secret"
            ],
            "additionalProperties": false
          },
          "extend_secret": {
            "type": "string",
            "minLength": 16,
            "maxLength": 200
          },
          "client_metadata": {
            "type": "object",
            "propertyNames": {
              "type": "string",
              "minLength": 1,
              "maxLength": 64
            },
            "additionalProperties": {
              "type": "string",
              "maxLength": 200
            }
          }
        },
        "additionalProperties": false
      },
      "LiveKitSessionGrant": {
        "$schema": "https://json-schema.org/draft/2020-12/schema",
        "type": "object",
        "properties": {
          "status": {
            "default": "ready",
            "type": "string",
            "const": "ready"
          },
          "session_id": {
            "type": "string",
            "minLength": 1
          },
          "room_name": {
            "type": "string",
            "minLength": 1
          },
          "livekit_url": {
            "type": "string",
            "minLength": 1
          },
          "participant_token": {
            "type": "string",
            "minLength": 1
          },
          "participant_identity": {
            "type": "string",
            "minLength": 1
          },
          "agent_name": {
            "type": "string",
            "minLength": 1
          },
          "capacity_pool": {
            "type": "string",
            "minLength": 1
          },
          "reservation_expires_at": {
            "type": "string",
            "format": "date-time",
            "pattern": "^(?:(?:\\d\\d[2468][048]|\\d\\d[13579][26]|\\d\\d0[48]|[02468][048]00|[13579][26]00)-02-29|\\d{4}-(?:(?:0[13578]|1[02])-(?:0[1-9]|[12]\\d|3[01])|(?:0[469]|11)-(?:0[1-9]|[12]\\d|30)|(?:02)-(?:0[1-9]|1\\d|2[0-8])))T(?:(?:[01]\\d|2[0-3]):[0-5]\\d(?::[0-5]\\d(?:\\.\\d+)?)?(?:Z|([+-](?:[01]\\d|2[0-3]):[0-5]\\d)))$"
          },
          "max_sessions_per_gpu": {
            "type": "integer",
            "exclusiveMinimum": 0,
            "maximum": 9007199254740991
          },
          "stt_mode": {
            "default": "server",
            "type": "string",
            "enum": [
              "server",
              "off"
            ]
          },
          "room_created": {
            "default": false,
            "type": "boolean"
          },
          "dispatch_created": {
            "default": false,
            "type": "boolean"
          },
          "join_timeout_seconds": {
            "default": 0,
            "type": "integer",
            "minimum": 0,
            "maximum": 9007199254740991
          },
          "idle_timeout_seconds": {
            "default": 0,
            "type": "integer",
            "minimum": 0,
            "maximum": 9007199254740991
          },
          "max_session_seconds": {
            "default": 0,
            "type": "integer",
            "minimum": 0,
            "maximum": 9007199254740991
          }
        },
        "required": [
          "status",
          "session_id",
          "room_name",
          "livekit_url",
          "participant_token",
          "participant_identity",
          "agent_name",
          "capacity_pool",
          "reservation_expires_at",
          "max_sessions_per_gpu",
          "stt_mode",
          "room_created",
          "dispatch_created",
          "join_timeout_seconds",
          "idle_timeout_seconds",
          "max_session_seconds"
        ],
        "additionalProperties": false
      },
      "LiveKitCapacitySnapshot": {
        "$schema": "https://json-schema.org/draft/2020-12/schema",
        "type": "object",
        "properties": {
          "capacity_pool": {
            "type": "string",
            "minLength": 1
          },
          "agent_name": {
            "type": "string",
            "minLength": 1
          },
          "max_sessions": {
            "type": "integer",
            "minimum": 0,
            "maximum": 9007199254740991
          },
          "max_sessions_per_gpu": {
            "type": "integer",
            "exclusiveMinimum": 0,
            "maximum": 9007199254740991
          },
          "worker_count": {
            "type": "integer",
            "minimum": 0,
            "maximum": 9007199254740991
          },
          "active_sessions": {
            "type": "integer",
            "minimum": 0,
            "maximum": 9007199254740991
          },
          "reserved_sessions": {
            "type": "integer",
            "minimum": 0,
            "maximum": 9007199254740991
          },
          "observed_worker_active_sessions": {
            "type": "integer",
            "minimum": 0,
            "maximum": 9007199254740991
          },
          "available_sessions": {
            "type": "integer",
            "minimum": 0,
            "maximum": 9007199254740991
          },
          "queue_size": {
            "type": "integer",
            "minimum": 0,
            "maximum": 9007199254740991
          },
          "admission_open": {
            "type": "boolean"
          },
          "recommended_retry_ms": {
            "type": "integer",
            "minimum": 0,
            "maximum": 9007199254740991
          },
          "load": {
            "type": "number",
            "minimum": 0,
            "maximum": 1
          }
        },
        "required": [
          "capacity_pool",
          "agent_name",
          "max_sessions",
          "max_sessions_per_gpu",
          "worker_count",
          "active_sessions",
          "reserved_sessions",
          "observed_worker_active_sessions",
          "available_sessions",
          "queue_size",
          "admission_open",
          "recommended_retry_ms",
          "load"
        ],
        "additionalProperties": false
      },
      "CapacityBusyResponse": {
        "$schema": "https://json-schema.org/draft/2020-12/schema",
        "type": "object",
        "properties": {
          "message": {
            "type": "string",
            "minLength": 1
          },
          "capacity": {
            "type": "object",
            "properties": {
              "capacity_pool": {
                "type": "string",
                "minLength": 1
              },
              "agent_name": {
                "type": "string",
                "minLength": 1
              },
