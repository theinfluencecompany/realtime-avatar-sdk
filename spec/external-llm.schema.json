{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "base_url": {
      "type": "string",
      "maxLength": 500,
      "format": "uri",
      "pattern": "^\\s*[Hh][Tt][Tt][Pp][Ss]:\\/\\/"
    },
    "token": {
      "type": "string",
      "minLength": 16,
      "maxLength": 4096
    },
    "fail_closed": {
      "description": "Refuse a failed external turn instead of falling back to the platform model. Absent preserves existing fallback.",
      "type": "boolean"
    },
    "visible_character": {
      "description": "An application renders a visible character independently of RTA audio/video transport.",
      "type": "object",
      "properties": {
        "renderer": {
          "type": "string",
          "const": "external"
        }
      },
      "required": [
        "renderer"
      ],
      "additionalProperties": false
    },
    "performance": {
      "description": "Opt in to generation identity and admission/cancellation producer events. Receiver playout synchronization requires audio_output correlated_pcm_v1.",
      "type": "string",
      "const": "v1"
    },
    "audio_output": {
      "description": "Deliver correlated 24 kHz mono PCM instead of the ordinary audio track. Requires performance v1, fail_closed true, mode voice and voice_webhook.",
      "type": "string",
      "const": "correlated_pcm_v1"
    },
    "text_output": {
      "description": "Receive complete ExternalSpeechSegment values in SSE rta_speech events, preserving caller utterance identity and text. Requires correlated PCM, performance v1 and fail_closed true.",
      "type": "string",
      "const": "speech_segments_v1"
    }
  },
  "required": [
    "base_url",
    "token"
  ],
  "additionalProperties": false,
  "serverAuthoritative": true,
  "dependentSchemas": {
    "audio_output": {
      "$schema": "https://json-schema.org/draft/2020-12/schema",
      "type": "object",
      "properties": {
        "performance": {
          "type": "string",
          "const": "v1"
        },
        "fail_closed": {
          "type": "boolean",
          "const": true
        }
      },
      "required": [
        "performance",
        "fail_closed"
      ]
    },
    "text_output": {
      "$schema": "https://json-schema.org/draft/2020-12/schema",
      "type": "object",
      "properties": {
        "performance": {
          "type": "string",
          "const": "v1"
        },
        "fail_closed": {
          "type": "boolean",
          "const": true
        },
        "audio_output": {
          "type": "string",
          "const": "correlated_pcm_v1"
        }
      },
      "required": [
        "performance",
        "fail_closed",
        "audio_output"
      ]
    }
  }
}
