{
  "name": "realtime-avatar-react",
  "version": "0.3.0",
  "description": "React, React Native and browser bindings for Realtime Avatar. Talks to your proxy route — never to the platform, and never with your API key.",
  "license": "MIT",
  "author": "The Influence Company",
  "homepage": "https://realtimeavatar.ai/docs",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/theinfluencecompany/realtime-avatar-sdk.git",
    "directory": "libs/sdk-react"
  },
  "bugs": {
    "url": "https://github.com/theinfluencecompany/realtime-avatar-sdk/issues"
  },
  "keywords": [
    "ai",
    "avatar",
    "realtime",
    "voice",
    "video",
    "agent",
    "full-duplex",
    "livekit",
    "sdk",
    "api-client",
    "zero-dependency"
  ],
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./react-native": {
      "types": "./dist/react-native.d.ts",
      "default": "./dist/react-native.js"
    },
    "./browser": {
      "types": "./dist/browser.d.ts",
      "default": "./dist/browser.js"
    },
    "./tools": {
      "types": "./dist/tools.d.ts",
      "default": "./dist/tools.js"
    }
  },
  "files": [
    "dist",
    "README.md"
  ],
  "engines": {
    "node": ">=20"
  },
  "sideEffects": false,
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "build": "tsup"
  },
  "dependencies": {
    "livekit-client": "^2.9.0",
    "zod": "^4.4.3"
  },
  "peerDependencies": {
    "@livekit/components-react": "^2.9.0",
    "@livekit/react-native": "^2.11.0",
    "react": ">=18",
    "react-dom": ">=18",
    "react-native": ">=0.78"
  },
  "peerDependenciesMeta": {
    "@livekit/components-react": {
      "optional": true
    },
    "@livekit/react-native": {
      "optional": true
    },
    "react-dom": {
      "optional": true
    },
    "react-native": {
      "optional": true
    }
  },
  "devDependencies": {
    "@livekit/components-react": "2.9.21",
    "@livekit/react-native": "^2.11.1",
    "@types/react": "19.2.7",
    "react": "19.2.7",
    "react-dom": "19.2.7",
    "react-native": "0.81.5",
    "tsup": "^8.5.0",
    "typescript": "^5.9.2"
  }
}
