{
  "name": "realtime-avatar",
  "version": "0.7.3",
  "description": "Realtime Avatar SDK. `realtime-avatar` and the route adapters hold your API key and are server-only; `realtime-avatar/react`, `/browser` and `/tools` never can — importing a server entry into a browser build throws at bundle time.",
  "license": "MIT",
  "author": "The Influence Company",
  "homepage": "https://realtimeavatar.ai/docs",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/theinfluencecompany/realtime-avatar-sdk.git",
    "directory": "libs/sdk-server"
  },
  "bugs": {
    "url": "https://github.com/theinfluencecompany/realtime-avatar-sdk/issues"
  },
  "keywords": [
    "ai",
    "avatar",
    "realtime",
    "voice",
    "video",
    "agent",
    "full-duplex",
    "livekit",
    "sdk",
    "api-client",
    "react",
    "react-native"
  ],
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "workerd": "./dist/index.js",
      "browser": "./dist/server-only-guard.js",
      "react-native": "./dist/server-only-guard.js",
      "default": "./dist/index.js"
    },
    "./server": {
      "types": "./dist/server.d.ts",
      "workerd": "./dist/server.js",
      "browser": "./dist/server-only-guard.js",
      "react-native": "./dist/server-only-guard.js",
      "default": "./dist/server.js"
    },
    "./nextjs": {
      "types": "./dist/nextjs.d.ts",
      "workerd": "./dist/nextjs.js",
      "browser": "./dist/server-only-guard.js",
      "react-native": "./dist/server-only-guard.js",
      "default": "./dist/nextjs.js"
    },
    "./hono": {
      "types": "./dist/hono.d.ts",
      "workerd": "./dist/hono.js",
      "browser": "./dist/server-only-guard.js",
      "react-native": "./dist/server-only-guard.js",
      "default": "./dist/hono.js"
    },
    "./express": {
      "types": "./dist/express.d.ts",
      "workerd": "./dist/express.js",
      "browser": "./dist/server-only-guard.js",
      "react-native": "./dist/server-only-guard.js",
      "default": "./dist/express.js"
    },
    "./tanstack-start": {
      "types": "./dist/tanstack-start.d.ts",
      "workerd": "./dist/tanstack-start.js",
      "browser": "./dist/server-only-guard.js",
      "react-native": "./dist/server-only-guard.js",
      "default": "./dist/tanstack-start.js"
    },
    "./react": {
      "types": "./dist/react.d.ts",
      "default": "./dist/react.js"
    },
    "./react-native": {
      "types": "./dist/react-native.d.ts",
      "default": "./dist/react-native.js"
    },
    "./browser": {
      "types": "./dist/browser.d.ts",
      "default": "./dist/browser.js"
    },
    "./tools": {
      "types": "./dist/tools.d.ts",
      "default": "./dist/tools.js"
    }
  },
  "files": [
    "dist",
    "README.md"
  ],
  "engines": {
    "node": ">=20"
  },
  "sideEffects": [
    "./dist/server-only-guard.js"
  ],
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "build": "tsup"
  },
  "devDependencies": {
    "tsup": "^8.5.0",
    "typescript": "^5.9.2",
    "@livekit/components-react": "2.9.21",
    "@livekit/react-native": "^2.11.1",
    "@types/react": "19.2.7",
    "react": "19.2.7",
    "react-dom": "19.2.7",
    "react-native": "0.81.5"
  },
  "peerDependencies": {
    "@livekit/components-react": "^2.9.0",
    "@livekit/react-native": "^2.11.0",
    "react": ">=18",
    "react-dom": ">=18",
    "react-native": ">=0.78",
    "livekit-client": "^2.9.0"
  },
  "peerDependenciesMeta": {
    "@livekit/components-react": {
      "optional": true
    },
    "@livekit/react-native": {
      "optional": true
    },
    "react-dom": {
      "optional": true
    },
    "react-native": {
      "optional": true
    },
    "react": {
      "optional": true
    },
    "livekit-client": {
      "optional": true
    }
  },
  "dependencies": {
    "zod": "^4.4.3"
  }
}
