{
  "name": "realtime-avatar",
  "version": "0.40.0",
  "description": "Realtime Avatar (realtimeavatar.ai) SDK for real-time AI avatars: live, interruptible talking characters with voice and lip-synced video over LiveKit WebRTC, for Node servers, React and React Native. The server entries hold your API key; the React, React Native and browser entries never can.",
  "license": "MIT",
  "author": "The Influence Company",
  "homepage": "https://realtimeavatar.ai/docs?utm_source=npm",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/theinfluencecompany/realtime-avatar-sdk.git",
    "directory": "libs/sdk-server"
  },
  "bugs": {
    "url": "https://github.com/theinfluencecompany/realtime-avatar-sdk/issues"
  },
  "keywords": [
    "ai",
    "avatar",
    "realtime",
    "voice",
    "video",
    "agent",
    "full-duplex",
    "livekit",
    "sdk",
    "api-client",
