{
  "mcpServers": {
    "realtime-avatar": {
      "type": "stdio",
      "command": "node",
      "args": [
        "${CURSOR_PLUGIN_ROOT}/account.mjs"
      ],
      "env": {
        "RTA_PLUGIN_API_KEY": "${RTA_API_KEY}",
        "RTA_PLUGIN_ALLOW_WRITES": "${RTA_ALLOW_WRITES}"
      }
    }
  }
}
