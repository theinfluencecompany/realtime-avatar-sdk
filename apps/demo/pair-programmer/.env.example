# Server-only. The SDK constructor throws in a browser runtime, so this cannot leak by accident.
REALTIME_AVATAR_API_KEY=tic_test_...

# The character to call. A host platform sets this to the avatar the user picked, and it wins
# over everything else. Leave it unset and the app calls the first READY, VIDEO-sourced avatar
# on this key — an avatar built from a still image also reports `ready`, then publishes a black
# track, so the source kind is checked rather than assumed.
#
# This layout composites the character into the room: full height in their own column, with the
# app on glass in front of them. A clip shot against BLACK drops into that scene; a clip shot in
# a bright room reads as a photograph pasted onto a website. The page scrims and vignettes as a
# fallback, but casting is the real fix.
#
# Shipped cast with Kit — the hoodie engineer `apps/demo/terminal-tutor` teaches from, shot
# against a black void, which is exactly what this composite wants. If you point this at someone
# else, change `VOICE` in server.mjs with it: an unpinned call lets the platform choose a voice,
# and it reads neither the face nor the persona.
AVATAR_ID=
# The same thing under the name the older examples in this repo use. AVATAR_ID takes priority.
REALTIME_AVATAR_ID=

# The SECOND model — the one that writes the app. Server-only for the same reason.
# Any OpenAI-compatible endpoint works; point OPENAI_BASE_URL elsewhere to use one.
OPENAI_API_KEY=
OPENAI_BASE_URL=https://api.openai.com/v1
CODE_MODEL=gpt-4.1

# OPTIONAL — publishing. Set BOTH or neither.
#
# With neither, this is a local studio: build, preview, restore versions, no share link. The
# publish tool is not registered and nobody is briefed on it, because a verb the model can call
# that always fails is worse than one that never existed.
#
# With both, Publish uploads the current page as a Worker and puts it on
# https://<name>.<your-subdomain>.workers.dev.
#
# The token needs exactly one permission: Account > Workers Scripts > Edit. Create it at
# https://dash.cloudflare.com/profile/api-tokens — "Create Token", then the "Edit Cloudflare
# Workers" template, or a custom token with just that permission scoped to the account below.
# Wrangler cannot mint this for you: an OAuth session is refused by the token API (9109), so
# `wrangler login` is not a substitute for this variable.
#
# READ THIS BEFORE SETTING IT. Publishing puts MODEL-GENERATED HTML, described out loud by
# whoever is on the call, on a public URL under a subdomain you own. That is an abuse surface.
# Scope the token to one account you do not mind being associated with, and clear up after
# yourself: every script this app creates is named `rta-pair-<8 hex>`, so that prefix is the
# whole cleanup list. It is deliberately NOT the coding companion's `rta-studio-` prefix —
# running both demos on one account should leave two cleanup lists, not one ambiguous pile.
CLOUDFLARE_API_TOKEN=
CLOUDFLARE_ACCOUNT_ID=

# Hard stop, in seconds, on every call this app starts.
MAX_CALL_SECONDS=300
PORT=4196
