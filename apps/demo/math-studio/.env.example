# Server-only. The SDK constructor throws in a browser runtime, so this cannot leak by accident.
REALTIME_AVATAR_API_KEY=tic_test_...

# The cast. Set one avatar per character to get all three in the picker — each one carries its
# own persona line and its own voice preset, both decided server-side in server.mjs.
AVATAR_ID_LIN=
AVATAR_ID_WANG=
AVATAR_ID_WUKONG=

# Set none of the three and the app falls back to the single-avatar convention the other examples
# use, and the picker collapses to that one character. AVATAR_ID wins over REALTIME_AVATAR_ID;
# with neither, the first READY, VIDEO-sourced avatar on this key is used — an avatar built from
# a still image also reports `ready` and then publishes a black track, so the source kind is
# checked rather than assumed.
AVATAR_ID=
REALTIME_AVATAR_ID=

# Hard stop, in seconds, on every call this app starts. A ten-task run needs longer than a chat,
# and a learner working on screen is slower than one just talking.
MAX_CALL_SECONDS=420
PORT=4199
