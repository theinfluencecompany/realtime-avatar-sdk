# Server-only. The SDK constructor throws in a browser runtime, so this cannot leak by accident.
REALTIME_AVATAR_API_KEY=tic_test_...

# The character to sell as. A host platform sets this to the avatar the user picked, and it wins
# over everything else. Leave it unset and the app calls the first READY, VIDEO-sourced avatar on
# this key — an avatar built from a still image also reports `ready`, then publishes an all-black
# track, which on a shopping stream is a product nobody can see.
#
# Whatever you point this at, FRAME IT TIGHT ON THE FACE. A video-sourced avatar cut as a medium
# shot preprocesses, reports `ready`, mints calls — and then its render worker never joins, which
# reaches the page only as "no remote participant joined before the timeout". Head-and-shoulders
# works; a presenter standing in a set does not. 1:1 and 9:16 are both fine.
AVATAR_ID=
# The same thing under the name the older examples in this repo use. AVATAR_ID takes priority.
REALTIME_AVATAR_ID=

# Hard stop, in seconds, on every stream this app starts. A run through five products with
# questions from chat needs longer than a greeting.
MAX_CALL_SECONDS=300
PORT=4197
