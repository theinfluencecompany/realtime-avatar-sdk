# Server-only. The SDK constructor throws in a browser runtime, so this cannot leak by accident.
REALTIME_AVATAR_API_KEY=tic_test_...

# Who teaches. AVATAR_ID wins over REALTIME_AVATAR_ID; with neither, the first READY,
# VIDEO-sourced avatar on this key is used — an avatar built from a still image also reports
# `ready` and then publishes an all-black track, so the source kind is checked rather than
# assumed.
#
# He is composited BEHIND translucent glass here, so the source clip earns its keep: one shot
# against a dark background gives the terminal its contrast for free. The page dims and vignettes
# as a fallback, but casting is the real fix.
AVATAR_ID=
REALTIME_AVATAR_ID=

# Hard stop, in seconds, on every call this app starts. Nine lessons at demonstrate-then-your-turn
# is a slow format — a learner hunting for the colon key is not a learner talking.
MAX_CALL_SECONDS=420

PORT=4194
