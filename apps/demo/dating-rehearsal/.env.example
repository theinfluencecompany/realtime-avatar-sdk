# Server-only. The SDK constructor throws in a browser runtime, so this cannot leak by accident.
REALTIME_AVATAR_API_KEY=tic_test_...

# The photo -> looping-video step. A live avatar needs a VIDEO source, and the realtime-avatar API
# does not turn a still image into one — so an uploaded photo is rendered into a seamless idle loop
# with an image-to-video model (fal), and this key stays on the server. Get one at fal.ai.
FAL_KEY=
# Any fal image-to-video app that accepts `end_image_url` (pinned to the first frame -> a closed
# loop) works. MiniMax H3 is the default: it takes real faces without a photoreal refusal.
FAL_MODEL=minimax/h3/image-to-video

# The FALLBACK date, for the "blind date" button (no photo uploaded). A host platform sets this to
# the avatar the user picked; leave it unset and the app calls the first READY, VIDEO-sourced avatar
# on this key — an avatar built from a still image also reports `ready`, then publishes a black
# track, so the source kind is checked rather than assumed.
AVATAR_ID=
# The same thing under the name the older examples in this repo use. AVATAR_ID takes priority.
REALTIME_AVATAR_ID=

# Hard stop, in seconds, on every date this app starts.
MAX_CALL_SECONDS=300
PORT=4195
