# Server-only. The SDK constructor throws in a browser runtime, so this cannot leak by accident.
REALTIME_AVATAR_API_KEY=tic_test_...

# The character to stream as. A host platform sets this to the avatar the user picked, and it
# wins over everything else. Leave it unset and the app calls the first READY, VIDEO-sourced
# avatar on this key — an avatar built from a still image also reports `ready`, then publishes a
# black track, so the source kind is checked rather than assumed.
AVATAR_ID=
# The same thing under the name the older examples in this repo use. AVATAR_ID takes priority.
REALTIME_AVATAR_ID=

# Hard stop, in seconds, on every stream this app starts.
MAX_CALL_SECONDS=300
PORT=4198
