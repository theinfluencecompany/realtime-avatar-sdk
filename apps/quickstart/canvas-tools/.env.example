# Server-only. `new RealtimeAvatar()` throws in a browser runtime, so this cannot leak by
# accident — but it starts calls on your account, so keep it out of anything the client sees.
REALTIME_AVATAR_API_KEY=

# The image model's key. Server-only for the same reason: the browser tool calls YOUR
# /api/draw/generate route, never fal directly, so this is the one place metering, caching
# and moderation can live.
FAL_KEY=

# The character to call. A host platform sets this to the avatar the user picked, and it wins
# over everything else. Leave it unset and the app calls the first READY, VIDEO-sourced avatar
# on this key — an avatar built from a still image also reports `ready` and then publishes a
# black track, so the source kind is checked rather than assumed.
AVATAR_ID=
REALTIME_AVATAR_ID=

# Hard stop, in seconds, on every call this app starts. Nothing else bounds the spend.
MAX_CALL_SECONDS=300

# Any fal text-to-image endpoint. schnell is the cheap fast one.
FAL_MODEL=fal-ai/flux/schnell

PORT=4193
