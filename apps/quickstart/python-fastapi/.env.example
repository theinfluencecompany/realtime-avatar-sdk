REALTIME_AVATAR_API_KEY=tic_test_...
REALTIME_AVATAR_ID=ava_...
# Public https URL of this server's /api/transcript — the platform POSTs the session
# history there when a call ends. Locally: `cloudflared tunnel --url http://localhost:8000`
# and use the printed https host.
TRANSCRIPT_URL=https://your.app/api/transcript
# Shared secret for the transcript webhook. Any random string, >= 16 chars.
TRANSCRIPT_SECRET=
