# Server-only. Never prefix with NEXT_PUBLIC_ — that inlines it into the client bundle.
REALTIME_AVATAR_API_KEY=tic_test_...
# The character to call. Create one with rta.createAvatarFromVideo() — a VIDEO source.
REALTIME_AVATAR_ID=ava_...
# Optional: speak the call in your own voice. The public https URL of app/api/voice; leave it
# empty to keep the avatar's own voice. The secret is any random string, >= 16 chars.
VOICE_WEBHOOK_URL=
VOICE_WEBHOOK_SECRET=
# app/api/voice synthesizes with OpenAI's speech API.
OPENAI_API_KEY=
